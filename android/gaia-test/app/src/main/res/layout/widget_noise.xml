<?xml version="1.0" encoding="utf-8"?>
<!-- Noise widget, design v4 section 9: surface card, three round buttons with labels.
     Colours only from @color; the selected state swaps views, so the launcher repaints it in dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/w_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="6dp" android:paddingBottom="2dp"
        android:text="Noise control" android:textColor="@color/ink2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_note" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_adaptive" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Adaptive">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
                <ImageView android:id="@+id/w_adaptive_on" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_on" android:src="@drawable/ic_adaptive" android:tint="@color/on_key" android:visibility="gone" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/w_adaptive_off" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_off" android:src="@drawable/ic_adaptive" android:tint="@color/ink2" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="3dp"
                android:text="Adaptive" android:textSize="12sp" android:textColor="@color/ink" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_custom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Custom">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
                <ImageView android:id="@+id/w_custom_on" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_on" android:src="@drawable/ic_custom" android:tint="@color/on_key" android:visibility="gone" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/w_custom_off" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_off" android:src="@drawable/ic_custom" android:tint="@color/ink2" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="3dp"
                android:text="Custom" android:textSize="12sp" android:textColor="@color/ink" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_off" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:contentDescription="Off">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp">
                <ImageView android:id="@+id/w_off_on" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_on" android:src="@drawable/ic_off" android:tint="@color/on_key" android:visibility="gone" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/w_off_off" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="9dp"
                    android:background="@drawable/w_circle_off" android:src="@drawable/ic_off" android:tint="@color/ink2" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="3dp"
                android:text="Off" android:textSize="12sp" android:textColor="@color/ink" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
